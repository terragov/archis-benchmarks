{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runs/<v>/run.json",
  "description": "What a run contains, the status of each benchmark family in it, and why.",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "tag",
    "kind",
    "date",
    "chi_version",
    "harness",
    "families"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "archis-benchmarks.run.v1"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tag": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "run",
        "snapshot"
      ]
    },
    "date": {
      "type": "string"
    },
    "chi_version": {
      "type": "string",
      "pattern": "^chi \\d+\\.\\d+\\.\\d+$"
    },
    "harness": {
      "type": "object",
      "required": [
        "public"
      ],
      "properties": {
        "public": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "method",
          "files"
        ],
        "properties": {
          "status": {
            "enum": [
              "headline",
              "evidence",
              "withdrawn"
            ]
          },
          "method": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "binary_attribution": {
            "enum": [
              "row-stamp",
              "file-stamp",
              "run-report"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "withdrawn_commands": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "match",
          "before",
          "after",
          "evidence",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "match": {
            "type": "object"
          },
          "before": {
            "type": "object"
          },
          "after": {
            "type": "object"
          },
          "evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
