{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runs/<v>/fase_b/relations.json",
  "description": "Relation recall per repository against the oracle.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "repo",
      "language",
      "chi"
    ],
    "properties": {
      "repo": {
        "type": "string"
      },
      "language": {
        "type": "string"
      },
      "calls_recall": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "heritage_recall": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "chi": {
        "type": "string",
        "pattern": "^chi \\d+\\.\\d+\\.\\d+$"
      }
    }
  }
}
