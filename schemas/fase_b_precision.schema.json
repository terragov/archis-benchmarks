{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runs/<v>/fase_b/precision.json",
  "description": "Precision by sampling per repository (evidence; see KNOWN_LIMITATIONS.md).",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "repo",
      "language",
      "chi"
    ],
    "properties": {
      "repo": {
        "type": "string"
      },
      "language": {
        "type": "string"
      },
      "symbol_precision": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "calls_precision": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "negatives_total": {
        "type": [
          "integer",
          "null"
        ]
      },
      "negatives_invented": {
        "type": [
          "integer",
          "null"
        ]
      },
      "chi": {
        "type": "string",
        "pattern": "^chi \\d+\\.\\d+\\.\\d+$"
      }
    }
  }
}
